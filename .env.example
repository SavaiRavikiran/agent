# Copy to .env and fill in real values. Never commit the real .env or bake it into the Docker image.

# Optional: enables real Claude instead of the offline fallback LLM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: enables Langfuse tracing/eval. Leave blank to run with tracing disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Local Langfuse from inside Docker Desktop (Mac/Windows): http://host.docker.internal:3000
# Local Langfuse when running the script directly on the host: http://localhost:3000
LANGFUSE_HOST=http://localhost:3000

DEMO_USER_ID=cli-user
DEMO_SESSION_ID=cli-demo-session
LOG_LEVEL=INFO
